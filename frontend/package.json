{
  "name": "mausam-setu",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"*.js\" \"scripts/*.mjs\" \"tests/*.{js,mjs}\"",
    "test:planning": "node tests/planning-browser.mjs",
    "test:merge": "node tests/merge-browser.mjs",
    "test:part1": "node tests/part1-browser.mjs",
    "test:offline": "npm run build && node tests/offline-browser.mjs",
    "test:part2": "node tests/part2-browser.mjs",
    "test:part3": "node tests/part3-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "3.4.19",
    "vite": "^6.4.1"
  }
}
